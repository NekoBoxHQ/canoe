# 轻舟 / Canoe Server —— systemd unit
#
# 安装：
#   sudo cp deploy/canoe-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now canoe-api

[Unit]
Description=Canoe Server (轻舟 服务端)
Documentation=https://github.com/your-org/canoe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canoe
Group=canoe
WorkingDirectory=/opt/canoe/canoe-server

# .env 里的配置由应用自己读（pydantic-settings）。
# 这里额外把 PATH 指到 venv，方便运维手动 exec 进去排查。
EnvironmentFile=-/opt/canoe/canoe-server/.env
Environment="PATH=/opt/canoe/canoe-server/.venv/bin:/usr/local/bin:/usr/bin:/bin"

# ⚠ --workers 必须保持 1
#    推送中心（/api/events）是进程内的内存结构。多 worker 时管理端的广播
#    只会在它自己那个进程里扩散，挂在别的 worker 上的客户端永远收不到 ——
#    表现是"推送时灵时不灵"。要多 worker 得先把 EventHub 换成 Redis 发布订阅。
#    见 canoe_server/services/broadcast.py 顶部说明。
ExecStart=/opt/canoe/canoe-server/.venv/bin/uvicorn canoe_server.app:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGINT

# ---- 加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 只放开数据目录和安装包目录
ReadWritePaths=/opt/canoe/canoe-server/data /opt/canoe/canoe-server/releases

[Install]
WantedBy=multi-user.target
