# 复制成 .env 再改。生产环境务必替换所有 CHANGE_ME。

DEBUG=false
HOST=0.0.0.0
PORT=8000

# 小项目用 SQLite；生产建议 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://canoe:password@127.0.0.1:5432/canoe
DATABASE_URL=sqlite:///./data/canoe.db

# --- 密钥 ---
# 生成: python -c "import secrets;print(secrets.token_urlsafe(48))"
TICKET_SECRET=CHANGE_ME_ticket_secret_before_production

# 登录令牌有效期（秒），默认 1 天
TOKEN_TTL=86400
# 入口凭证有效期（秒）
ENTRY_TICKET_TTL=300

HEARTBEAT_INTERVAL=30
ONLINE_TIMEOUT=90
DEFAULT_EXPIRE_DAYS=30
DEFAULT_MAX_DEVICES=3

# --- 初始化管理员（seed.py 读取）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=canoe-admin-123

# --- 中转层 ---
# true: Nginx 在 443 终止 TLS，按 WS 路径反代到本机 20000+ 端口（推荐）
RELAY_BEHIND_NGINX=true
RELAY_INTERNAL_BASE=20000
RELAY_LISTEN=::
RELAY_PORT=443
RELAY_TLS_CERT=/etc/sing-box/cert.pem
RELAY_TLS_KEY=/etc/sing-box/key.pem
RELAY_CONFIG_OUT=./data/relay_config.json
# 节点变更后执行的命令，例如 systemctl restart sing-box
RELAY_RELOAD_HOOK=
