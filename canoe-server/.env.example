# 复制成 .env 再改。生产环境务必替换所有 CHANGE_ME。

DEBUG=false
HOST=0.0.0.0
# 客户端口。客户端固定拿这个端口取更新和订阅（deploy/install.sh 默认 58588）。
# 这个口必须对所有用户开放。
PORT=58588
# 管理面板端口。0 = 和 PORT 同口。
# 填了别的（例如 58589）就另开一个口：客户端口不再响应 /panel，
# 你可以在防火墙/安全组里只放行自己的 IP。两个口是同一个进程监听。
PANEL_PORT=0
# TLS 证书。两个都填 = 直接跑 HTTPS（不需要 Nginx）；
# 留空 = 跑 HTTP，交给前面的 Nginx 终止 TLS。
TLS_CERT=
TLS_KEY=

# 小项目用 SQLite；生产建议 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://canoe:password@127.0.0.1:5432/canoe
DATABASE_URL=sqlite:///./data/canoe.db

# 登录令牌有效期（秒），默认 1 天。会话也跟它同寿。
TOKEN_TTL=86400

# --- 订阅密钥的静态加密 ---
# tokens 表里的 sub_key 是解密订阅的钥匙，现在是**加密后**落库的，
# 加密用的主密钥就是这一项。留空会自动退回 TICKET_SECRET；两个都没有
# 就在 data/subkey.key 生成一把（0600，跟数据库放在一起）。
# 生产建议在这里配一把自己的（放在 .env，跟数据库分开存放）：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# ⚠ 一旦有值就别再改 —— 换掉之后已存的 sub_key 全部解不开，
#   客户端会收到空信封、销毁本地订阅（重新登录即可恢复）。
SECRET_KEY=

# --- 反向代理 ---
# 是否信任 X-Forwarded-For。**默认 false，别乱开。**
# 服务端直连公网时（本项目的默认部署）开着它等于让任何人伪造来源 IP，
# 审计日志会变假、按 IP 的限速也能被绕过。
# 只有放在 Nginx/Apache 后面（反代会覆盖这个头）时才设为 true。
TRUST_PROXY=false

# --- 登录 / 注册限速（进程内滑动窗口，重启清零）---
# 同一用户名连续失败这么多次就锁一段时间。/api/login 每次要跑 24 万次
# PBKDF2，没有这道闸就是个不用登录就能按下去的 CPU 开关。
LOGIN_MAX_FAILS=10
LOGIN_FAIL_WINDOW=300
LOGIN_LOCK_SECONDS=300
# 同一 IP 在窗口内最多注册几个号。注册不需要任何凭据，不限速就是
# 一台免费的造号机（还会顺带占满推送连接池）。
REGISTER_MAX_PER_IP=5
REGISTER_WINDOW=3600

HEARTBEAT_INTERVAL=30
ONLINE_TIMEOUT=90
DEFAULT_EXPIRE_DAYS=30
DEFAULT_MAX_DEVICES=3

# --- 初始化管理员（seed.py 读取）---
# ⚠️ ADMIN_PASSWORD 下面这个值是**占位符，不是密码**：仓库是公开的，
#    任何人都能搜到这个字符串。seed.py 见到它就现生成一把随机的并打印出来。
#    想指定自己的密码，就把这行改掉再跑 seed.py；
#    用 deploy/install.sh 装的话它本来就会生成随机的，不用管这里。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=canoe-admin-123

# --- Web 管理面板 ---
# 纯静态（HTML+CSS+JS，无构建步骤），挂在这个路径上
PANEL_PATH=/panel

# --- 客户端更新（安装包自托管）---
# 对外域名，用来拼安装包下载地址。留空则按请求的 Host 现算 ——
# 生产建议写死，免得被 Host 头带偏。
PUBLIC_BASE_URL=https://api.canoe.example.com
# 单个安装包上限（MB）
MAX_RELEASE_MB=300

# --- 推送（SSE）---
# 保活注释间隔（秒）。中间的 Nginx 会把长时间没数据的连接掐掉，所以要有。
SSE_KEEPALIVE=20
# 同时在线长连接上限 / 单账号上限，防打满
SSE_MAX_CONNECTIONS=2000
SSE_MAX_PER_USER=5
